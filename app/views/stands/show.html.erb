<% content_for :title, "#{@stand.name} - MyStandMap" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Breadcrumb -->
  <nav class="text-sm text-gray-500 mb-4">
    <a href="/" class="hover:text-green-600">Home</a> 
    <span class="mx-2">/</span>
    <span><%= @stand.city %>, <%= @stand.state %></span>
  </nav>

  <div class="grid lg:grid-cols-3 gap-8">
    <!-- Main Info -->
    <div class="lg:col-span-2">
      <!-- Header -->
      <div class="bg-white rounded-xl shadow-sm p-6 mb-6">
        <div class="flex items-start justify-between mb-4">
          <div>
            <h1 class="text-3xl font-bold text-gray-800"><%= @stand.name %></h1>
            <p class="text-gray-600 mt-1">
              <span class="inline-block bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm">
                <%= @stand.stand_type&.gsub('_', ' ')&.titleize || 'Farm Stand' %>
              </span>
              <% if @stand.verified? %>
                <span class="ml-2 inline-block bg-blue-100 text-blue-700 px-3 py-1 rounded-full text-sm">✓ Verified</span>
              <% end %>
              <% if @stand.claimed? %>
                <span class="ml-2 inline-block bg-purple-100 text-purple-700 px-3 py-1 rounded-full text-sm">👨‍🌾 Owner Verified</span>
              <% end %>
            </p>
          </div>
        </div>
        
        <% if @stand.description.present? %>
          <p class="text-gray-700 mb-4"><%= @stand.description %></p>
        <% end %>
        
        <!-- Address -->
        <div class="flex items-start gap-3 mb-4">
          <svg class="w-5 h-5 text-gray-400 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <div>
            <p class="text-gray-700"><%= @stand.address_1 %></p>
            <p class="text-gray-600"><%= @stand.city %>, <%= @stand.state %> <%= @stand.zip %></p>
          </div>
        </div>
        
        <!-- Get Directions -->
        <a href="https://www.google.com/maps/search/?api=1&query=<%= URI.encode_www_form_component(@stand.full_address) %>" 
           target="_blank"
           class="inline-flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
          </svg>
          Get Directions
        </a>
      </div>
      
      <!-- Hours -->
      <% if @stand.hours_text.present? %>
      <div class="bg-white rounded-xl shadow-sm p-6 mb-6">
        <h2 class="text-xl font-semibold text-gray-800 mb-4">🕐 Hours</h2>
        <p class="text-gray-700 whitespace-pre-line"><%= @stand.hours_text %></p>
      </div>
      <% end %>
      
      <!-- Products -->
      <% if @stand.products_text.present? %>
      <div class="bg-white rounded-xl shadow-sm p-6 mb-6">
        <h2 class="text-xl font-semibold text-gray-800 mb-4">🥬 Products</h2>
        <p class="text-gray-700"><%= @stand.products_text %></p>
      </div>
      <% end %>
      
      <!-- Contact -->
      <div class="bg-white rounded-xl shadow-sm p-6">
        <h2 class="text-xl font-semibold text-gray-800 mb-4">📞 Contact</h2>
        <div class="space-y-3">
          <% if @stand.phone.present? %>
            <p class="text-gray-700">
              <span class="font-medium">Phone:</span> 
              <a href="tel:<%= @stand.phone %>" class="text-green-600 hover:underline"><%= @stand.phone %></a>
            </p>
          <% end %>
          <% if @stand.email.present? %>
            <p class="text-gray-700">
              <span class="font-medium">Email:</span> 
              <a href="mailto:<%= @stand.email %>" class="text-green-600 hover:underline"><%= @stand.email %></a>
            </p>
          <% end %>
          <% if @stand.website_url.present? %>
            <p class="text-gray-700">
              <span class="font-medium">Website:</span> 
              <a href="<%= @stand.website_url %>" target="_blank" class="text-green-600 hover:underline"><%= @stand.website_url %></a>
            </p>
          <% end %>
          <% if @stand.facebook_url.present? %>
            <p class="text-gray-700">
              <span class="font-medium">Facebook:</span> 
              <a href="<%= @stand.facebook_url %>" target="_blank" class="text-green-600 hover:underline">Facebook Page</a>
            </p>
          <% end %>
        </div>
      </div>
    </div>
    
    <!-- Sidebar -->
    <div>
      <!-- Claim CTA -->
      <% unless @stand.claimed? %>
        <div class="bg-white rounded-xl shadow-sm p-6 mb-6 border-2 border-green-500">
          <h3 class="text-lg font-semibold text-gray-800 mb-2">Is this your stand?</h3>
          <p class="text-gray-600 text-sm mb-4">Claim this listing to update hours, products, and connect with customers.</p>
          <% if user_signed_in? %>
            <a href="<%= new_claim_path(stand_id: @stand.id) %>" class="block w-full bg-green-600 hover:bg-green-700 text-white text-center px-4 py-2 rounded-lg font-medium">
              Claim This Stand
            </a>
          <% else %>
            <a href="<%= new_user_registration_path %>" class="block w-full bg-green-600 hover:bg-green-700 text-white text-center px-4 py-2 rounded-lg font-medium">
              Sign Up to Claim
            </a>
          <% end %>
        </div>
      <% end %>
      
      <!-- Map Preview -->
      <div class="bg-white rounded-xl shadow-sm p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">📍 Location</h3>
        <div class="bg-gray-100 rounded-lg h-48 flex items-center justify-center">
          <% if @stand.latitude && @stand.longitude %>
            <a href="https://www.google.com/maps/@<%= @stand.latitude %>,<%= @stand.longitude %>,15z" target="_blank" class="text-green-600 hover:underline">
              View on Google Maps
            </a>
          <% else %>
            <p class="text-gray-500">Location available on map</p>
          <% end %>
        </div>
      </div>
      
      <!-- Last Updated -->
      <div class="mt-4 text-center text-sm text-gray-500">
        Last updated: <%= @stand.updated_at.strftime("%B %d, %Y") %>
      </div>
    </div>
  </div>
</div>
