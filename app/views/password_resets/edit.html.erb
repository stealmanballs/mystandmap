<div class="max-w-md mx-auto mt-8 p-6 bg-white rounded-lg shadow-md">
  <h1 class="text-2xl font-bold mb-6">Reset Password</h1>
  
  <%= form_with model: @user, url: password_reset_path(params[:id]), method: :patch do |f| %>
    <% if @user.errors.any? %>
      <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-md">
        <ul class="text-sm text-red-600">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    
    <div class="mb-4">
      <%= f.label :password, "New password", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password, required: true, minlength: 6, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
    </div>
    
    <div class="mb-4">
      <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password_confirmation, required: true, minlength: 6, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
    </div>
    
    <%= f.submit "Update Password", class: "w-full bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700" %>
  <% end %>
</div>
