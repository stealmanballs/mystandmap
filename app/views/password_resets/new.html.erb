<div class="max-w-md mx-auto mt-8 p-6 bg-white rounded-lg shadow-md">
  <h1 class="text-2xl font-bold mb-6">Forgot Password</h1>
  
  <%= form_with url: password_reset_path, method: :post do |f| %>
    <div class="mb-4">
      <%= f.label :email, "Email address", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
    </div>
    
    <%= f.submit "Send Reset Instructions", class: "w-full bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700" %>
  <% end %>
  
  <p class="mt-4 text-center text-sm text-gray-600">
    Remember your password? <%= link_to "Sign in", new_session_path, class: "text-green-600 hover:underline" %>
  </p>
</div>
