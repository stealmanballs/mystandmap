<% content_for :title, "Import Stands - MyStandMap" %>

<div class="max-w-3xl mx-auto px-4 py-8">
  <div class="mb-6">
    <a href="/admin/dashboard" class="text-green-600 hover:underline">← Back to Admin Dashboard</a>
  </div>
  
  <div class="bg-white rounded-xl shadow-sm p-6">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">Import Stands from CSV</h1>
    
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
      <h3 class="font-medium text-blue-800 mb-2">CSV Format</h3>
      <p class="text-sm text-blue-700 mb-2">Your CSV should include these columns:</p>
      <code class="text-xs bg-white px-2 py-1 rounded block">
        stand_name, address, city, state, zip, latitude, longitude, stand_type, products_available, open_hours, contact_phone, contact_email, website_or_facebook
      </code>
      <p class="text-sm text-blue-700 mt-2">
        <strong>Supported stand types:</strong> farm_stand, u_pick, roadside_stand, farmers_market
      </p>
    </div>
    
    <%= form_with url: import_csv_admin_stands_path, multipart: true do |f| %>
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-2">Select CSV File</label>
        <%= f.file_field :file, accept: ".csv", class: "w-full px-4 py-2 border border-gray-300 rounded-lg" %>
      </div>
      
      <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-medium">
        Import Stands
      </button>
    <% end %>
    
    <div class="mt-6 pt-6 border-t border-gray-200">
      <h3 class="font-medium text-gray-800 mb-2">Download Template</h3>
      <a href="/templates/stands_import_template.csv" class="text-green-600 hover:underline">
        Download CSV Template
      </a>
    </div>
  </div>
</div>
